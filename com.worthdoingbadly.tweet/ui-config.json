{
  "inputs": [
    {
      "name": "accountEmail",
      "type": "text",
      "prompt": "Email",
      "placeholder": "hello@example.com"
    },
    {
      "name": "accountPassword",
      "type": "text",
      "prompt": "Password",
      "placeholder": "(Only stored locally.)"
    },
    {
      "name": "accountTwoFactor",
      "type": "text",
      "prompt": "Two-factor code (if any)",
      "placeholder": "123456",
      "value": "(none)"
    },
    {
      "name": "includeFeed",
      "type": "switch",
      "prompt": "Include For You feed",
      "value": "on"
    },
    {
      "name": "includeMentions",
      "type": "switch",
      "prompt": "Include Mentions"
    }
  ]
}
